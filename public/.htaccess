<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Never let the LiteSpeed / LWS edge cache the platform admin. Otherwise a
    # stray GET to a POST-only action (e.g. /castlit-admin/clients/action) gets
    # its 404 cached and then served to real POSTs. Bypassing the cache here
    # (before the app) also ignores any already-poisoned entry.
    RewriteRule ^castlit-admin(/.*)?$ - [E=Cache-Control:no-cache,E=cache-control:no-cache]

    # Vite names each built file after its content (app-BFhZmHcd.js): a new
    # build is a new name, so a browser may keep each one for a year instead
    # of asking the server again on every page. Not sw.js, nor anything else
    # outside build/assets, whose names do not change.
    RewriteRule ^build/assets/ - [E=CASTLIT_HASHED_ASSET:1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Photos and logos are served by the app, never through the storage
    # symlink (some hosts refuse to follow it and answer 403).
    RewriteRule ^storage/ index.php [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable" env=CASTLIT_HASHED_ASSET
</IfModule>
